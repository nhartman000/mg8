{
  "g8son_version": "1.0",
  "file_id": "example.object-eligibility.001",
  "gates": [
    {
      "gate_id": "object_confidence",
      "order": 1,
      "type": "AND",
      "conditions": [
        "object_detected",
        "confidence > 0.9"
      ],
      "outcomes": {
        "PASS": "continue",
        "FAIL": "stop",
        "INTERMEDIATE": "review"
      },
      "metadata": {
        "description": "Generic bounded eligibility-gate example"
      }
    }
  ],
  "metadata": {
    "note": "Runtime state is supplied by .gst. Each execution attempt receives its own trace_id in the audit layer."
  }
}
